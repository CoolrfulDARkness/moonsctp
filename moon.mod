name = "CoolrfulDARkness/moonsctp"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/CoolrfulDARkness/moonsctp"

license = "Apache-2.0"

keywords = [
  "sctp",
  "pr-sctp",
  "rfc9260",
  "rfc3758",
  "webrtc",
  "datachannel",
  "sans-io",
  "crc32c",
  "transport",
  "networking",
]

preferred_target = "wasm"

description = "Pure MoonBit, zero-FFI, Sans-I/O IETF RFC 9260 SCTP and RFC 3758 PR-SCTP multi-stream reliable transport protocol stack with Castagnoli CRC-32C, stateless HMAC-SHA256 cookie handshake, and deterministic chaos simulator."
